{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": 
  {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=DotnetAPIBasicAuthentication;Integrated Security=True;TrustServerCertificate=True;"
  },

  "jwt": {
    "key": "ThisIsASecretKeyForDevelopment123456789",
    "issuer": "http://localhost:5260",
    "audience": "http://localhost:5260"
  },
  "Attachment":{
    "AllowedExtensions": ".pdf,.doc,.docx,.xls,.xlsx,.jpg,.png,.gif,.mp4,.avi,.mkv,.mov,.wmv,.flv,.webm",
    "MaxFileSize": "1024",
    "EnableCompression": false
  }
}
